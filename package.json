{
  "name": "novel-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build": "tsc -b && vite build",
    "adapters:new": "node --experimental-strip-types tools/adapter-new.ts",
    "extensions:check": "node --experimental-strip-types tools/extensions-check.ts",
    "generation:a0": "node --experimental-strip-types tools/generation-a0.ts",
    "generation:eval": "node --experimental-strip-types tools/generation-eval.ts",
    "generation:eval:long": "node --experimental-strip-types tools/generation-eval.ts examples/long-memory-benchmark",
    "generation:l1-diagnose": "node --experimental-strip-types tools/generation-l1-diagnose.ts",
    "generation:kappa": "node --experimental-strip-types tools/judge-kappa.ts",
    "lint": "oxlint",
    "memory:eval": "node --experimental-strip-types tools/memory-eval.ts",
    "memory:eval:long": "node --experimental-strip-types tools/memory-eval.ts examples/long-memory-benchmark",
    "project:check": "node --experimental-strip-types tools/project-check.ts",
    "project:import": "node --experimental-strip-types tools/project-import.ts",
    "project:new": "node --experimental-strip-types tools/project-new.ts",
    "providers:check": "node --experimental-strip-types tools/provider-check.ts",
    "publisher:check": "node --experimental-strip-types tools/publisher-check.ts",
    "publisher:dry-run": "node --experimental-strip-types publisher/cli.ts --adapter dry-run",
    "skills:check": "node --experimental-strip-types tools/skill-check.ts",
    "skills:new": "node --experimental-strip-types tools/skill-new.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview",
    "verify": "npm run workspace:check && npm run test -- --reporter=dot && npm run typecheck && npm run lint && npm run build",
    "workspace:check": "node --experimental-strip-types tools/workspace-check.ts",
    "workspace:check:long": "node --experimental-strip-types tools/workspace-check.ts --benchmark"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.7.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@radix-ui/react-slot": "^1.3.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff-match-patch": "^1.0.5",
    "lucide-react": "^1.21.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
