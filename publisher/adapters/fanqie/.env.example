# Fanqie publisher example config.
# Keep real cookies, browser profiles, and account data outside the novel project.

# Paste the writer backend chapter-management URL here. The adapter extracts book_id.
xiaoshuo_menu=https://fanqienovel.com/main/writer/1234567890/chapter-manage

# Directory containing chapter Markdown files. Relative paths resolve from this env file.
wenzhang_menu=../../../examples/demo-novel/manuscript/volume-001

# Progress is stored outside source manuscript files.
PUBLISH_PROGRESS_PATH=../../../.novel/publisher-progress.json

# Optional runtime settings for the standalone CLI.
PUBLISH_INTERVAL_SECONDS=5
PUBLISH_DRY_RUN=1
