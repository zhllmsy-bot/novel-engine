{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-engine.local/schemas/memory-eval.schema.json",
  "title": "Novel Engine Memory Eval Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["expectations"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "chapter_id": {
      "type": "string",
      "minLength": 1
    },
    "budget_chars": {
      "type": "integer",
      "minimum": 1
    },
    "minimum_gain": {
      "type": "integer",
      "minimum": 0
    },
    "expectations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/expectation"
      }
    }
  },
  "$defs": {
    "memoryLayer": {
      "type": "string",
      "enum": ["L0 事实", "L1 剧情", "L2 风格", "L3 意图"]
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "contains"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "$ref": "#/$defs/memoryLayer"
        },
        "contains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "not_contains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_contains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
